{
  "name": "workpulse",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "Workpulse — Enterprise Attendance System (multi-tenant HRTech)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test --filter='!@workpulse/e2e'",
    "test:watch": "turbo run test:watch --parallel",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @workpulse/api prisma:generate",
    "db:migrate": "pnpm --filter @workpulse/api prisma:migrate",
    "db:migrate:create-only": "pnpm --filter @workpulse/api prisma:migrate:create-only",
    "db:migrate:deploy": "pnpm --filter @workpulse/api prisma:migrate:deploy",
    "db:migrate:status": "pnpm --filter @workpulse/api prisma:migrate:status",
    "db:migrate:reset": "pnpm --filter @workpulse/api prisma:migrate:reset",
    "db:seed": "pnpm --filter @workpulse/api prisma:seed",
    "db:seed:uat": "pnpm --filter @workpulse/api prisma:seed:uat",
    "db:studio": "pnpm --filter @workpulse/api prisma:studio",
    "e2e": "pnpm --filter @workpulse/e2e test",
    "e2e:ui": "pnpm --filter @workpulse/e2e test:ui",
    "e2e:headed": "pnpm --filter @workpulse/e2e test:headed",
    "e2e:install": "pnpm --filter @workpulse/e2e install:browsers",
    "e2e:report": "pnpm --filter @workpulse/e2e report",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  }
}
