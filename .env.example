# ============================================================
# Workpulse — Environment Variables (copy to .env, never commit)
# ============================================================

NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

# ---- Backend (apps/api) ----
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://workpulse:workpulse@localhost:5432/workpulse?schema=public"
SHADOW_DATABASE_URL="postgresql://workpulse:workpulse@localhost:5432/workpulse_shadow?schema=public"

# JWT
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="replace-me-with-another-long-random-string"
JWT_REFRESH_EXPIRES_IN=7d

# File storage (attachments — doctor notes, permit files)
STORAGE_DRIVER=s3               # local | s3 (s3 = MinIO/AWS/S3-compatible)
STORAGE_LOCAL_ROOT=./storage/uploads

# S3 (or MinIO for local dev — see docker-compose.yml)
S3_BUCKET=workpulse
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=workpulse
S3_SECRET_ACCESS_KEY=workpulse-secret
S3_ENDPOINT=http://localhost:9000      # leave empty for real AWS S3
S3_FORCE_PATH_STYLE=true               # required for MinIO
S3_PRESIGN_PUT_TTL_SECONDS=300         # 5 minutes
S3_PRESIGN_GET_TTL_SECONDS=3600        # 1 hour

# ---- Email transport -------------------------------------
# Options: console | disabled | smtp
#   console  — dev default; logs the message to stdout
#   disabled — no-op; in-app notifications still work
#   smtp     — nodemailer over SMTP (Amazon SES / SendGrid /
#              Mailgun / Postmark all offer SMTP endpoints)
# The env validator refuses to boot in production with anything
# other than `smtp`.
EMAIL_TRANSPORT=console
EMAIL_FROM="Workpulse <no-reply@workpulse.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false              # true = SMTPS on 465; false = STARTTLS on 587
SMTP_USER=
SMTP_PASS=
# When `true`, `SmtpEmailAdapter` runs `transporter.verify()` at boot
# and logs the result. Failures are warnings, not fatal.
SMTP_VERIFY_ON_BOOT=false

# ---- Security headers (Fase 30c) --------------------------
# Extra origins added to CSP `img-src` / `connect-src` on the API.
# Comma-separated. Leave empty in production.
API_CSP_EXTRA_ORIGINS=
# HSTS preload: adds `preload` + `max-age=63072000`. Only enable on
# production deploys with valid HTTPS certs on ALL subdomains —
# irreversible for browsers that pick it up from the preload list.
HSTS_PRELOAD=false

# ---- MFA (Multi-Factor Authentication) --------------------
# 32-byte AES-256-GCM key (base64). Generate with:  openssl rand -base64 32
# REQUIRED in production. Rotating this invalidates every enrolled TOTP
# secret — plan a re-enroll flow before rotating.
MFA_SECRET_ENCRYPTION_KEY=
MFA_ISSUER=Workpulse
MFA_BACKUP_CODES_COUNT=8
# Enforce MFA enrollment for HR_MANAGER + SUPER_ADMIN. Default `true`
# (production posture). Flip to `false` ONLY for local dev / E2E — the
# env validator refuses to start with `false` in production.
MFA_ENFORCE_HR_ADMIN=true

# ---- Data Subject Access Request (DSAR / UU PDP, Fase 31a) ----
# Cooldown between two `POST /me/data-export` calls per user, in hours.
# 24 is the standard "one export per day" cap.
DATA_EXPORT_COOLDOWN_HOURS=24
# Kill switch for the background worker. When `false`, the API keeps
# accepting new PENDING requests but does NOT process them (assumes
# a separate node is running the worker).
DATA_EXPORT_WORKER_ENABLED=true

# ---- Data privacy: right-to-erasure (Fase 31b) --------------
# Grace period (in days) between HR/admin approval and the worker
# actually anonymising the user. Gives the user a chance to walk
# it back after the decision is made. Range 1–30.
DATA_ERASURE_GRACE_DAYS=7
# Kill switch for the erasure worker. When `false`, approved
# requests accumulate as APPROVED_SCHEDULED but never execute on
# this API instance (assumes a separate node is running).
DATA_ERASURE_WORKER_ENABLED=true

# ---- Fase 31c: Retention automation + consent tracking -----
# Kill switch for the retention worker. When `false`, tenant
# retention configs are still writable but the daily sweep is
# skipped on this instance. Use to run the worker on a single
# primary node in a multi-instance deployment.
RETENTION_WORKER_ENABLED=true

# ---- Retention Enforcement Audit (OPS-6) -------------------
# Kill switch for the monthly attestation cron (day 1 05:30 UTC).
# Set to false on follower replicas so only the primary node runs
# the once-a-month audit + DPO notification fanout.
RETENTION_AUDIT_WORKER_ENABLED=true

# ---- Tenant usage snapshot (OPS-7) -------------------------
# Kill switch for the monthly per-tenant usage snapshot cron
# (day 1 06:00 UTC). Basis for future billing tier & capacity
# planning. Set to false on follower replicas.
TENANT_USAGE_WORKER_ENABLED=true

# ---- Vendor / Processor review reminder (Fase 31f) --------
# Kill switch for the daily vendor reminder worker (07:00 UTC).
# Scans VendorProcessor rows and fires VENDOR_REVIEW_DUE (T-30d)
# and VENDOR_CONTRACT_EXPIRING (T-60d) alerts to HR_MANAGER +
# SUPER_ADMIN. Dedup keyed by expectedFor so a rescheduled cycle
# fires anew. Set to false on follower replicas.
VENDOR_REVIEW_REMINDER_WORKER_ENABLED=true

# ---- Timesheet export sharing (Fase 32d) -------------------
# Externally-reachable base URL of THIS API (no trailing slash,
# no /api/v1 suffix). Used to build absolute signed download links.
PUBLIC_API_URL=http://localhost:4000
# HMAC-SHA256 signing secret used to mint / verify signed download URLs
# for timesheet exports. Mandatory in production. Generate with:
#   openssl rand -base64 32
TIMESHEET_EXPORT_SIGNING_SECRET=
# Default lifetime for a share link (hours). Bounded 1..168.
TIMESHEET_EXPORT_SHARE_TTL_HOURS=24

# ---- Outbound webhooks (Fase 32e) --------------------------
# Kill switch for the delivery worker — set false on follower replicas.
WEBHOOK_WORKER_ENABLED=true
# Per-request outbound HTTP timeout in ms (1000..30000).
WEBHOOK_HTTP_TIMEOUT_MS=10000
# Max delivery attempts per event before marking FAILED (1..10).
WEBHOOK_MAX_ATTEMPTS=4
# SSRF hardening — refuse loopback / private IP hosts.
WEBHOOK_BLOCK_PRIVATE_IPS=true

# ---- Timesheet scheduler (Fase 32f) ------------------------
# Kill switch for the daily auto-generation + reminder worker.
TIMESHEET_SCHEDULER_ENABLED=true

# ---- Analytics snapshot (Fase 33a) -------------------------
# Kill switch for the nightly executive-KPI snapshot worker.
# `false` on follower replicas so only the primary materialises
# rows into AnalyticsSnapshot. The dashboard endpoint keeps
# reading from the table regardless.
ANALYTICS_SNAPSHOT_ENABLED=true

# --- Reports Scheduler (Fase 33c) ---------------------------------------
# Kill switch for the cron-driven scheduled report dispatcher. Follower
# replicas should set this to `false` so only one instance does the work.
REPORT_SCHEDULER_ENABLED=true

# ---- Observability -----------------------------------------
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Force pino-pretty output. Only set `true` locally — production log
# aggregators (Datadog, Loki, CloudWatch) need the raw JSON stream.
LOG_PRETTY=false

# Sentry — leave DSN empty to disable capture entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# ---- Test-only escape hatch (never `true` in production) ---
THROTTLER_DISABLED=false

# ---- Frontend (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
