# ============================================================
# Workpulse — Production Environment Variables
# ------------------------------------------------------------
# Copy to `.env.production` on the server. Keep it OFF git.
# Recommended permissions:
#   chown root:docker .env.production
#   chmod 640 .env.production
#
# ROTATE these values before first launch:
#   - JWT_SECRET, JWT_REFRESH_SECRET
#   - MFA_SECRET_ENCRYPTION_KEY
#   - TIMESHEET_EXPORT_SIGNING_SECRET
#   - POSTGRES_PASSWORD
#   - S3_* credentials
#   - BACKUP_* credentials
# ============================================================

NODE_ENV=production
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
LOG_PRETTY=false

# ---- Domains (used by Caddy for TLS + reverse proxy) --------
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# ---- Backend (apps/api) ----
API_PORT=4000
API_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# ---- Container image tags ----
# Bump to a specific tag for prod. `latest` is fine for staging.
API_IMAGE=ghcr.io/workpulse/api
WEB_IMAGE=ghcr.io/workpulse/web
IMAGE_TAG=latest

# ---- PostgreSQL ----
POSTGRES_USER=workpulse
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
POSTGRES_DB=workpulse
# Consumed by the API via the `postgres` service name.
DATABASE_URL="postgresql://workpulse:CHANGE_ME_LONG_RANDOM_STRING@postgres:5432/workpulse?schema=public&connection_limit=20"

# ---- JWT ----
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# ---- File storage (attachments) ----
STORAGE_DRIVER=s3
S3_BUCKET=workpulse-attachments
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_PUT_TTL_SECONDS=300
S3_PRESIGN_GET_TTL_SECONDS=3600

# ---- Email transport (production requires smtp) ----
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Workpulse <no-reply@example.com>"
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_VERIFY_ON_BOOT=true

# ---- Security ----
API_CSP_EXTRA_ORIGINS=
HSTS_PRELOAD=false
# openssl rand -base64 32
MFA_SECRET_ENCRYPTION_KEY=CHANGE_ME
MFA_ISSUER=Workpulse
MFA_BACKUP_CODES_COUNT=8
# MVP: MFA is opt-in for all roles (`false`). Voluntary enrollment
# is still surfaced in /settings/security and every enrolled user
# is challenged at login. Flip to `true` in a future milestone to
# force HR + SUPER_ADMIN through /setup-mfa on first request.
MFA_ENFORCE_HR_ADMIN=false

# ---- Compliance ----
DATA_EXPORT_COOLDOWN_HOURS=24
DATA_EXPORT_WORKER_ENABLED=true
DATA_ERASURE_GRACE_DAYS=7
DATA_ERASURE_WORKER_ENABLED=true
RETENTION_WORKER_ENABLED=true
RETENTION_AUDIT_WORKER_ENABLED=true
TENANT_USAGE_WORKER_ENABLED=true
VENDOR_REVIEW_REMINDER_WORKER_ENABLED=true

# ---- Timesheet export sharing ----
# openssl rand -base64 32
TIMESHEET_EXPORT_SIGNING_SECRET=CHANGE_ME
TIMESHEET_EXPORT_SHARE_TTL_HOURS=24

# ---- Webhooks ----
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_HTTP_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=4
WEBHOOK_BLOCK_PRIVATE_IPS=true

# ---- Schedulers ----
TIMESHEET_SCHEDULER_ENABLED=true
ANALYTICS_SNAPSHOT_ENABLED=true
REPORT_SCHEDULER_ENABLED=true
BREACH_REMINDER_WORKER_ENABLED=true

# ---- Observability ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# 0.1 = sample 10% of transactions. Bump only if the plan has room.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta

# =============================================================================
# Backup sidecar (docker-compose.prod.yml → service `backup`)
# =============================================================================
# Cloudflare R2 example. For AWS S3 set BACKUP_S3_PROVIDER=AWS and BACKUP_S3_ENDPOINT
# to the regional URL, or leave BACKUP_S3_ENDPOINT empty to use default AWS.
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_S3_REGION=auto
BACKUP_BUCKET=workpulse-backups
BACKUP_PREFIX=workpulse
# `age-keygen` — put the PRIVATE key OFFLINE. Only the recipient (public) key
# lives here. Loss of the private key = permanent inability to decrypt backups.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# Retention window. 30 days is a good default; regulatory retention for the
# operational DB itself is separately handled by the RetentionWorker.
BACKUP_RETENTION_DAYS=30
# Cron in UTC (5-field). Default: 19:15 UTC = 02:15 Asia/Jakarta.
BACKUP_CRON=15 19 * * *

# =============================================================================
# Test-only escape hatches — MUST stay false in production.
# =============================================================================
THROTTLER_DISABLED=false
